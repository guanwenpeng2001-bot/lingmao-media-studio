# Lingmao Media Studio — Docker Compose Environment Template
# Copy to .env (gitignored) and override values for your target environment.
# Production deployments MUST replace POSTGRES_PASSWORD and inject real webhook secrets.

# --- Reverse Proxy / Web Entrypoint ---
WEB_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=lingmao_studio
POSTGRES_USER=postgres
# Dev-only placeholder; override with a strong random password in production.
POSTGRES_PASSWORD=postgres

# --- Backend Runtime (Fail-Closed Defaults) ---
# Defaults to "live"; set to "sandbox" only when explicitly using docker-compose.sandbox.yml.
LINGMAO_ENV_MODE=live
LINGMAO_DEMO_INFERENCE_ENABLED=false
LINGMAO_SANDBOX_BILLING_ENABLED=false
LINGMAO_SANDBOX_OTP_ENABLED=false

# Never commit secrets or sandbox OTP codes. Inject via environment at runtime:
#   python -c "import secrets; print(secrets.token_hex(32))"
LINGMAO_SANDBOX_OTP_CODE=
LINGMAO_PAYMENT_WEBHOOK_SECRET=
LINGMAO_GENERATION_WEBHOOK_SECRET=

# --- Proxy & Origin Verification ---
LINGMAO_TRUST_PROXY_HEADERS=true
LINGMAO_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Uncomment when serving strictly behind HTTPS termination (auto-detected from X-Forwarded-Proto when omitted):
# LINGMAO_COOKIE_SECURE=true

# --- P1 Feature Flags (Disabled in P0) ---
LINGMAO_FEATURE_VIRTUAL_TRYON=false
LINGMAO_FEATURE_ORG_COLLABORATION=false
LINGMAO_FEATURE_AUDIO_STUDIO=false

# --- Credits & Worker Tuning ---
LINGMAO_INITIAL_TRIAL_CREDITS=100
LINGMAO_WORKER_POLL_INTERVAL_SECONDS=0.5
LINGMAO_WORKER_LEASE_SECONDS=30
