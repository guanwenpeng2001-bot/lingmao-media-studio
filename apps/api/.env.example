# PostgreSQL connection string
LINGMAO_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/lingmao_studio

# Environment & mode: "sandbox" for local integration, "live" for production
LINGMAO_ENV_MODE=sandbox

# Private object storage directory (must reside outside the Git repository)
LINGMAO_STORAGE_DIR=C:/Users/Administrator/orca/workspaces/lingmao-media-studio-work/backend-ecommerce/storage

# Explicit opt-in for deterministic development inference adapter (must be false in production)
LINGMAO_DEMO_INFERENCE_ENABLED=true

# Live generation provider endpoint (e.g. ComfyUI or cloud provider; required when LINGMAO_DEMO_INFERENCE_ENABLED=false)
LINGMAO_LIVE_PROVIDER_URL=
LINGMAO_LIVE_PROVIDER_API_KEY=

# Explicit opt-in for sandbox payment / OTP simulation (never triggers real billing)
LINGMAO_SANDBOX_BILLING_ENABLED=true
LINGMAO_SANDBOX_OTP_ENABLED=true
LINGMAO_SANDBOX_OTP_CODE=123456

# Live payment & SMS credentials (leave empty in local integration)
LINGMAO_PAYMENT_MERCHANT_ID=
LINGMAO_PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
LINGMAO_GENERATION_WEBHOOK_SECRET=dev-generation-webhook-secret
LINGMAO_SMS_PROVIDER_URL=

# P1 Feature Flags (default false in P0)
LINGMAO_FEATURE_VIRTUAL_TRYON=false
LINGMAO_FEATURE_ORG_COLLABORATION=false
LINGMAO_FEATURE_AUDIO_STUDIO=false

# Initial trial grant credits on first login
LINGMAO_INITIAL_TRIAL_CREDITS=100
LINGMAO_QUOTE_TTL_SECONDS=900
LINGMAO_WORKER_POLL_INTERVAL_SECONDS=0.5
LINGMAO_WORKER_LEASE_SECONDS=30
