# PostgreSQL connection string
LINGMAO_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/lingmao_studio

# Environment & mode: defaults to "live"; set to "sandbox" only for isolated local development
LINGMAO_ENV_MODE=live

# Private object storage directory (must reside outside the Git repository)
LINGMAO_STORAGE_DIR=C:/Users/Administrator/orca/workspaces/lingmao-media-studio-work/backend-ecommerce/storage

# Sandbox / demo switches default to false. Only enable explicitly in local sandbox mode.
LINGMAO_DEMO_INFERENCE_ENABLED=false
LINGMAO_SANDBOX_BILLING_ENABLED=false
LINGMAO_SANDBOX_OTP_ENABLED=false
LINGMAO_SANDBOX_OTP_CODE=

# Webhook HMAC secrets must be injected via environment variables (no hardcoded defaults).
# For local sandbox testing, generate random secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LINGMAO_PAYMENT_WEBHOOK_SECRET=
LINGMAO_GENERATION_WEBHOOK_SECRET=

# Live external channel configuration placeholders (live adapters are not connected in Stage 5;
# setting these without a verified live channel implementation will still return 503)
LINGMAO_LIVE_PROVIDER_URL=
LINGMAO_LIVE_PROVIDER_API_KEY=
LINGMAO_PAYMENT_MERCHANT_ID=
LINGMAO_SMS_PROVIDER_URL=

# P1 Feature Flags (default false in P0)
LINGMAO_FEATURE_VIRTUAL_TRYON=false
LINGMAO_FEATURE_ORG_COLLABORATION=false
LINGMAO_FEATURE_AUDIO_STUDIO=false

# Initial trial grant credits on first login
LINGMAO_INITIAL_TRIAL_CREDITS=100
LINGMAO_QUOTE_TTL_SECONDS=900
LINGMAO_WORKER_POLL_INTERVAL_SECONDS=0.5
LINGMAO_WORKER_LEASE_SECONDS=30
